{
  "manifest_version": 3,
  "name": "Task Tracker",
  "version": "1.1",
  "description": "A simple task tracker with notifications.",
  "permissions": ["storage", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
